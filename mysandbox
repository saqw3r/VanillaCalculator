#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so install (symlink to PATH) still finds the repo root
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do script_path="$(readlink "$script_path")"; done
SCRIPT_DIR="$(cd "$(dirname "$script_path")" && pwd)"

# Fallback if symlink resolution failed (Windows Git Bash reparse points)
if [ ! -f "$SCRIPT_DIR/package.json" ]; then
  script_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  [ -n "$script_path" ] && SCRIPT_DIR="$(cd "$(dirname "$script_path")" && pwd)"
fi
if [ ! -f "$SCRIPT_DIR/package.json" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi

# Ensure setup.sh is executable
[ -x "$SCRIPT_DIR/setup.sh" ] || chmod +x "$SCRIPT_DIR/setup.sh" 2>/dev/null || true

COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
SANDBOX_DIR="/tmp/mysandbox"

# ── Config file ───────────────────────────────────────────────────────────────

for cfg in "${MYSANDBOX_CONFIG:-}" "$SCRIPT_DIR/mysandbox.config" "$HOME/.mysandbox.config"; do
  [ -f "$cfg" ] && { source "$cfg"; break; }
done

# ── Config via environment ────────────────────────────────────────────────────

MODE="${MYSANDBOX_MODE:-cli}"
PG_USER="${MYSANDBOX_PG_USER:-calculator}"
PG_PASS="${MYSANDBOX_PG_PASS:-calculator_pass}"
PG_DB="${MYSANDBOX_PG_DB:-calculator}"
PORT_BASE="${MYSANDBOX_API_PORT:-8090}"

# REPO_URL sourced from config (env var with same name)
REPO_URL="${MYSANDBOX_REPO_URL:-}"

# ── Remote SSH dispatch ───────────────────────────────────────────────────────

if [ -n "${MYSANDBOX_TARGET:-}" ]; then
  # Parse ssh://user@host or ssh://user@host:port
  target="${MYSANDBOX_TARGET#ssh://}"
  user="${target%%@*}"
  rest="${target#*@}"
  host="${rest%%:*}"
  port="${rest#*:}"
  [ "$port" = "$rest" ] && port=""

  # Base SSH args (no -t — added later for interactive session)
  ssh_args=""
  [ -n "${MYSANDBOX_SSH_KEY:-}" ] && ssh_args="$ssh_args -i $MYSANDBOX_SSH_KEY"
  [ -n "$port" ] && ssh_args="$ssh_args -p $port"

  remote_dir="${MYSANDBOX_REMOTE_DIR:-$SCRIPT_DIR}"

  # Ensure repo exists on the remote
  if ! ssh $ssh_args "$user@$host" "[ -f '$remote_dir/mysandbox' ]" 2>/dev/null; then
    if [ -n "$REPO_URL" ]; then
      echo "Cloning $REPO_URL → $remote_dir ..."
      ssh $ssh_args "$user@$host" "git clone '$REPO_URL' '$remote_dir'" || {
        echo "Failed to clone repo. Check MYSANDBOX_REPO_URL and remote access."
        exit 1
      }
    else
      echo "Error: remote directory '$remote_dir' not found."
      echo "  Set MYSANDBOX_REMOTE_DIR, or set MYSANDBOX_REPO_URL for auto-clone,"
      echo "  or clone the repo manually on the remote."
      exit 1
    fi
  elif [ -n "$REPO_URL" ]; then
    # Already cloned — pull latest
    ssh $ssh_args "$user@$host" "cd '$remote_dir' && git pull" 2>/dev/null || true
  fi

  # Build envs and exec into interactive remote sandbox session
  ssh_args="-t $ssh_args"
  envs="MYSANDBOX_TARGET='' MYSANDBOX_MODE='$MODE'"
  [ -n "$PORT_BASE" ] && envs="$envs MYSANDBOX_API_PORT='$PORT_BASE'"
  [ -n "$PG_USER" ]   && envs="$envs MYSANDBOX_PG_USER='$PG_USER'"
  [ -n "$PG_PASS" ]   && envs="$envs MYSANDBOX_PG_PASS='$PG_PASS'"
  [ -n "$PG_DB" ]     && envs="$envs MYSANDBOX_PG_DB='$PG_DB'"

  echo "Connecting to $MYSANDBOX_TARGET..."
  exec ssh $ssh_args "$user@$host" "cd '$remote_dir' && $envs ./mysandbox $*"
fi

# ── Helpers ───────────────────────────────────────────────────────────────────

find_port() {
  local base=$1 port=$1
  while :; do
    # Linux: ss (socket statistics)
    if ss -tln 2>/dev/null | grep -q ":$port "; then
      port=$((port + 1)); continue
    fi
    # Windows: netstat
    if command -v netstat &>/dev/null && netstat -ano 2>/dev/null | grep -q ":$port "; then
      port=$((port + 1)); continue
    fi
    break
  done
  echo "$port"
}

safe_rm() {
  rm -rf "$@" 2>/dev/null || {
    for d in "$@"; do
      [ -d "$d" ] && command -v cygpath &>/dev/null && cmd //c "rmdir /s /q \"$(cygpath -w "$d" 2>/dev/null)\"" 2>/dev/null || true
      [ -d "$d" ] && rm -rf "$d" 2>/dev/null || true
    done
  } || true
}

# ── Tunnel providers ─────────────────────────────────────────────────────────

start_ngrok() {
  local port=$1 pidfile=$2 logfile=$3
  if ! command -v ngrok &>/dev/null; then return 1; fi
  ngrok http "$port" --log=stdout > "$logfile" 2>&1 &
  echo $! > "$pidfile"
  local url=""
  for i in $(seq 1 20); do
    url=$(python3 -c "
import urllib.request, json
try:
  data = json.loads(urllib.request.urlopen('http://127.0.0.1:4040/api/tunnels').read())
  for t in data['tunnels']:
    if t.get('public_url'):
      print(t['public_url'])
      break
except: pass
" 2>/dev/null)
    [ -n "$url" ] && break
    sleep 1
  done
  [ -n "$url" ] && { echo "$url"; return 0; }
  return 1
}

start_cloudflared() {
  local port=$1 pidfile=$2 logfile=$3
  if ! command -v cloudflared &>/dev/null; then return 1; fi
  cloudflared tunnel --url "http://127.0.0.1:${port}" > "$logfile" 2>&1 &
  echo $! > "$pidfile"
  local url=""
  for i in $(seq 1 15); do
    url=$(grep -oP 'https://[a-zA-Z0-9.-]+\.trycloudflare\.com' "$logfile" 2>/dev/null || true)
    [ -n "$url" ] && break
    sleep 1
  done
  [ -n "$url" ] && { echo "$url"; return 0; }
  return 1
}

start_tunnel() {
  local port=$1 sandbox=$2 methodfile=$3 urlfile=$4
  local log="$sandbox/tunnel.log"
  local url
  url=$(start_ngrok "$port" "$sandbox/tunnel_pid" "$log") && {
    echo "ngrok" > "$methodfile"; echo "$url" > "$urlfile"; echo "$url"; return 0
  }
  url=$(start_cloudflared "$port" "$sandbox/tunnel_pid" "$log") && {
    echo "cloudflared" > "$methodfile"; echo "$url" > "$urlfile"; echo "$url"; return 0
  }
  return 1
}

stop_tunnel() {
  local sandbox=$1
  [ -f "$sandbox/tunnel_pid" ] && kill "$(cat "$sandbox/tunnel_pid")" 2>/dev/null || true
}

build_api() {
  if [ ! -f "$SCRIPT_DIR/.next/build-manifest.json" ]; then
    "$SCRIPT_DIR/setup.sh" build
  fi
}

# ── CLI mode (direct processes + system PostgreSQL) ─────────────────────────

resolve_db_mode() {
  local name=$1
  local sandbox="$SANDBOX_DIR/$name"
  mkdir -p "$sandbox"

  local pg_available=false
  if "$SCRIPT_DIR/setup.sh" db-check "${PG_DB}_${name}" "$PG_USER" 2>/dev/null; then
    pg_available=true
  fi

  local docker_ok=false podman_ok=false
  command -v docker &>/dev/null && docker info &>/dev/null 2>&1 && docker_ok=true
  command -v podman &>/dev/null && podman info &>/dev/null 2>&1 && podman_ok=true

  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════╗" >&2
  echo "║  How should this sandbox store data?                   ║" >&2
  echo "╚══════════════════════════════════════════════════════════╝" >&2
  echo "" >&2
  echo "  1) File-based store (no setup) — persists to a local JSON file" >&2
  if $docker_ok || $podman_ok; then
    echo "  2) Container mode — PostgreSQL in Docker/Podman container" >&2
  else
    echo "  2) Container mode — requires Docker or Podman (not detected)" >&2
  fi
  if $pg_available; then
    echo "  3) PostgreSQL (existing system installation)" >&2
  else
    echo "  3) Install PostgreSQL — show setup instructions" >&2
  fi
  echo "  s) Skip — run without persistence" >&2
  echo "" >&2
  local choice
  read -p "Choose [1/2/3/s] (default: 1): " choice
  choice="${choice:-1}"

  case "$choice" in
    1)
      echo "file" > "$sandbox/db_mode"
      echo "  Using file-based store." >&2
      ;;
    2)
      if $docker_ok && $podman_ok; then
        echo "" >&2
        echo "Both Docker and Podman are available." >&2
        echo "Which container runtime to use?" >&2
        echo "  1) Docker" >&2
        echo "  2) Podman" >&2
        echo "" >&2
        local rt_choice
        read -p "Choose [1/2] (default: 1): " rt_choice
        rt_choice="${rt_choice:-1}"
        local ct="docker"
        [ "$rt_choice" = "2" ] && ct="podman"
        echo "$ct" > "$sandbox/container_tool"
        echo "docker" > "$sandbox/db_mode"
        echo "  Using ${ct} to run the database container." >&2
      elif $docker_ok; then
        echo "docker" > "$sandbox/container_tool"
        echo "docker" > "$sandbox/db_mode"
        echo "  Using Docker to run the database container." >&2
      elif $podman_ok; then
        echo "podman" > "$sandbox/container_tool"
        echo "docker" > "$sandbox/db_mode"
        echo "  Using Podman to run the database container." >&2
      else
        echo "" >&2
        echo "No running container runtime found." >&2
        echo "" >&2
        echo "To install Docker:" >&2
        echo "  https://docs.docker.com/engine/install/" >&2
        echo "" >&2
        echo "To install Podman:" >&2
        echo "  Linux: sudo apt install podman" >&2
        echo "  macOS: brew install podman" >&2
        echo "  Windows: https://podman.io/docs/installation" >&2
        echo "" >&2
        echo "After installing, run 'mysandbox create $name' again." >&2
        exit 1
      fi
      ;;
    3)
      if $pg_available; then
        "$SCRIPT_DIR/setup.sh" db-create "${PG_DB}_${name}" "$PG_USER"
        echo "postgres" > "$sandbox/db_mode"
        echo "  Using existing PostgreSQL." >&2
      else
        echo "" >&2
        echo "To install PostgreSQL:" >&2
        echo "  Linux (Debian/Ubuntu): sudo apt install postgresql postgresql-client" >&2
        echo "  macOS: brew install postgresql" >&2
        echo "  Windows: https://www.postgresql.org/download/windows/" >&2
        echo "" >&2
        echo "After installing, run 'mysandbox create $name' again." >&2
        exit 1
      fi
      ;;
    s|S)
      echo "skip" > "$sandbox/db_mode"
      echo "  Skipping persistence." >&2
      ;;
    *)
      echo "file" > "$sandbox/db_mode"
      echo "  Using file-based store." >&2
      ;;
  esac
}

cli_drop_db() {
  local name=$1
  "$SCRIPT_DIR/setup.sh" db-drop "${PG_DB}_${name}" "$PG_USER"
}

cli_start_api() {
  local name=$1 port=$2
  local sandbox="$SANDBOX_DIR/$name"
  local db_mode
  db_mode=$(cat "$sandbox/db_mode" 2>/dev/null || echo "skip")
  mkdir -p "$sandbox"
  "$SCRIPT_DIR/setup.sh" start "$port" "$db_mode" "$sandbox"
  echo "$port" > "$sandbox/port"
}

cli_stop_api() {
  local sandbox=$1
  [ -f "$sandbox/pid" ] && kill "$(cat "$sandbox/pid")" 2>/dev/null || true
  sleep 1
}

cli_cleanup() {
  local name=$1
  local sandbox="$SANDBOX_DIR/$name"
  local db_mode
  db_mode=$(cat "$sandbox/db_mode" 2>/dev/null || echo "skip")
  stop_tunnel "$sandbox"
  cli_stop_api "$sandbox"
  if [ "$db_mode" = "postgres" ]; then
    cli_drop_db "$name" || true
  fi
  safe_rm "$sandbox"
}

cli_stop_all() {
  if [ ! -d "$SANDBOX_DIR" ]; then echo "No sandboxes to stop."; return 0; fi
  for dir in "$SANDBOX_DIR"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    echo "  stopping sandbox '$name'..."
    cli_cleanup "$name" || true
  done
}

# ── Docker mode (docker-compose per sandbox) ─────────────────────────────────

docker_start_api() {
  local name=$1 port=$2
  local sandbox="$SANDBOX_DIR/$name"
  local db_port=$(find_port $((port + 1000)))
  local ct
  ct=$(cat "$sandbox/container_tool" 2>/dev/null || echo "docker")
  mkdir -p "$sandbox"
  if ! "$SCRIPT_DIR/setup.sh" compose-start "$name" "$port" "$db_port" "$COMPOSE_FILE" "$ct"; then
    echo "${ct} is not available or failed to start." >&2
    echo "Run 'mysandbox create $name' again and choose a different option." >&2
    safe_rm "$sandbox"
    exit 1
  fi
  echo "$port" > "$sandbox/port"
  echo "$db_port" > "$sandbox/db_port"
  echo "$ct" > "$sandbox/container_tool"
}

docker_stop_api() {
  local name=$1
  local sandbox="$SANDBOX_DIR/$name"
  local ct
  ct=$(cat "$sandbox/container_tool" 2>/dev/null || echo "docker")
  "$SCRIPT_DIR/setup.sh" compose-stop "$name" "$COMPOSE_FILE" "$ct"
}

docker_cleanup() {
  local name=$1
  local sandbox="$SANDBOX_DIR/$name"
  stop_tunnel "$sandbox"
  docker_stop_api "$name"
  safe_rm "$sandbox"
}

docker_stop_all() {
  # Check Docker projects
  local projects
  projects=$(docker ps -q --filter "label=com.docker.compose.project" --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u) || true
  for project in $projects; do
    sandbox="$SANDBOX_DIR/$project"
    if [ -d "$sandbox" ]; then
      echo "  stopping sandbox '$project'..."
      docker_cleanup "$project" || true
    fi
  done
  # Check Podman projects
  projects=$(podman ps -q --filter "label=com.docker.compose.project" --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u) || true
  for project in $projects; do
    sandbox="$SANDBOX_DIR/$project"
    if [ -d "$sandbox" ]; then
      echo "  stopping sandbox '$project'..."
      docker_cleanup "$project" || true
    fi
  done
}

# ── Print helpers ────────────────────────────────────────────────────────────

print_info() {
  local name=$1 port=$2 url=$3 method=$4
  local sandbox="$SANDBOX_DIR/$name"
  local db_mode
  db_mode=$(cat "$sandbox/db_mode" 2>/dev/null || echo "skip")
  echo "Sandbox '$name' is live."
  echo "  API  http://127.0.0.1:$port"
  if [ "$db_mode" = "file" ]; then
    echo "  Store  $sandbox/calculations.json"
  elif [ "$db_mode" = "postgres" ]; then
    echo "  DB   postgresql://$PG_USER:$PG_PASS@localhost:5432/${PG_DB}_${name}"
  fi
  if [ -n "$url" ]; then
    echo "  Public URL ($method): $url"
    echo "  SANDBOX_URL=$url"
  fi
}

# ── Install / Uninstall ───────────────────────────────────────────────────────

cmd_install() {
  local src; src="$(readlink -f "$SCRIPT_DIR/mysandbox" 2>/dev/null || echo "$SCRIPT_DIR/mysandbox")"
  local rc_file=""
  [ -f "$HOME/.bashrc" ] && rc_file="$HOME/.bashrc"
  [ -f "$HOME/.zshrc" ] && rc_file="$HOME/.zshrc"
  [ -f "$HOME/.bash_profile" ] && rc_file="$HOME/.bash_profile"

  # Try system-wide
  if [ -d "/usr/local/bin" ]; then
    if [ -w "/usr/local/bin" ]; then
      ln -sf "$src" "/usr/local/bin/mysandbox"
      echo "Installed mysandbox → /usr/local/bin/mysandbox"
      return 0
    elif sudo -n true 2>/dev/null; then
      sudo ln -sf "$src" "/usr/local/bin/mysandbox"
      echo "Installed mysandbox → /usr/local/bin/mysandbox"
      return 0
    fi
  fi

  # Fallback: ~/.local/bin
  mkdir -p "$HOME/.local/bin"
  local dest="$HOME/.local/bin/mysandbox" installed=""

  # On Windows, generate both a .cmd shim (cmd.exe/PowerShell) and a
  # bash wrapper (Git Bash) — symlinks don't resolve correctly via MINGW.
  if [[ "$(uname -s)" =~ ^(MINGW|MSYS|CYGWIN) ]]; then
    local win_src
    win_src="$(cygpath -m "$SCRIPT_DIR/mysandbox" 2>/dev/null || echo "$SCRIPT_DIR/mysandbox")"

    # .cmd shim — for cmd.exe / PowerShell (finds bash.exe via PATHEXT)
    cat > "$HOME/.local/bin/mysandbox.cmd" << 'CMDEOF'
@echo off
setlocal enabledelayedexpansion
set "BASH="
for %%P in (
  "C:\Program Files\Git\bin\bash.exe"
  "C:\Program Files (x86)\Git\bin\bash.exe"
  "%LocalAppData%\Programs\Git\bin\bash.exe"
  "%USERPROFILE%\scoop\apps\git\current\bin\bash.exe"
) do if exist %%P set "BASH=%%~P" & goto :run
for %%X in (bash.exe) do set "BASH_PATH=%%~$PATH:X"
if defined BASH_PATH (
  set "BASH=!BASH_PATH!"
  echo !BASH_PATH! | findstr /I "System32 Sysnative" >nul
  if errorlevel 1 goto :run
)
echo mysandbox requires Git Bash. Install from https://git-scm.com
exit /b 1
:run
"%BASH%" "__SANDBOX_PATH__" %*
CMDEOF
    sed -i "s|__SANDBOX_PATH__|${win_src}|g" "$HOME/.local/bin/mysandbox.cmd"

    # Bash wrapper — so Git Bash can resolve `mysandbox` from PATH
    cat > "$dest" << BASHWRAP
#!/usr/bin/env bash
exec "${win_src}" "\$@"
BASHWRAP
    chmod +x "$dest"

    installed="$dest ($HOME/.local/bin/mysandbox.cmd)"
  else
    # Linux / macOS — symlink the bash script
    ln -sf "$src" "$dest"
    installed="$dest"
  fi

  if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    if [ -n "$rc_file" ]; then
      echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc_file"
      echo "Added ~/.local/bin to PATH in $rc_file"
    else
      rc_file="$HOME/.bash_profile"
      echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc_file"
      echo "Added ~/.local/bin to PATH in $rc_file (created)"
    fi
    export PATH="$HOME/.local/bin:$PATH"
  fi
  echo "Installed mysandbox → $installed"
  echo "Run 'source $rc_file' in new shells, or use 'mysandbox' right now."
}

cmd_uninstall() {
  local found=false
  for loc in "/usr/local/bin/mysandbox" "$HOME/.local/bin/mysandbox" "$HOME/.local/bin/mysandbox.cmd"; do
    if [ -f "$loc" ] || [ -L "$loc" ]; then
      if rm -f "$loc" 2>/dev/null; then
        echo "Removed $loc"
      elif sudo -n true 2>/dev/null; then
        sudo rm -f "$loc"
        echo "Removed $loc"
      else
        echo "Cannot remove $loc (permission denied). Try: sudo rm $loc" >&2
        continue
      fi
      found=true
    fi
  done
  $found || echo "mysandbox is not installed."
}

# ── Commands ─────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: mysandbox <command> [name]

Commands:
  run <name>      Start sandbox in foreground with public tunnel URL (Ctrl+C to stop)
  create <name>   Create & start a sandbox in background
  stop [name]     Stop sandbox(es). With a name stops one; without stops all
  list            List running sandboxes
  kill <name>     Stop & remove a sandbox
  logs <name>     Tail logs of a sandbox
  db <name>       Open psql shell for a sandbox
  install         Register mysandbox in the system PATH
  uninstall       Remove mysandbox from the system

Config (sourced from mysandbox.config or ~/.mysandbox.config):
  MYSANDBOX_TARGET     ssh://user@host or ssh://user@host:port (empty = local)
  MYSANDBOX_SSH_KEY    path to SSH identity file
  MYSANDBOX_REMOTE_DIR project directory on remote machine
  MYSANDBOX_REPO_URL   git URL for auto-clone/pull on remote (optional)
  MYSANDBOX_MODE       cli (default) or docker
  MYSANDBOX_API_PORT   port hint (empty = auto-select from 8090)
EOF
  exit 1
}

case "${1:-}" in
  run)
    NAME="${2:-}"; [ -z "$NAME" ] && usage
    PORT=$(find_port $PORT_BASE)
    SANDBOX="$SANDBOX_DIR/$NAME"

    # Reap any existing sandbox with this name (stale from unclean shutdown)
    [ -d "$SANDBOX" ] && safe_rm "$SANDBOX"

    build_api

    if [ "$MODE" = "docker" ]; then
      echo "  Starting container (Docker mode)..." >&2
      docker_start_api "$NAME" "$PORT"
    else
      resolve_db_mode "$NAME"
      db_mode=$(cat "$SANDBOX/db_mode")
      if [ "$db_mode" = "docker" ]; then
        echo "  Starting container..." >&2
        docker_start_api "$NAME" "$PORT"
      else
        echo "  Starting Next.js server..." >&2
        cli_start_api "$NAME" "$PORT"
      fi
    fi

    echo "Sandbox '$NAME' starting..."
    echo "  API  http://127.0.0.1:$PORT"

    printf "  Waiting for server" >&2
    waited=0
    frames=('.   ' '..  ' '... ')
    while [ $waited -lt 15 ]; do
      if command -v curl &>/dev/null && curl -s -o /dev/null "http://127.0.0.1:$PORT/api/calculate" 2>/dev/null; then
        printf "\r  Waiting for server      " >&2
        printf "\r  Almost ready...         \n" >&2
        break
      fi
      printf "\r  Waiting for server %s" "${frames[$((waited % 3))]}" >&2
      sleep 1
      waited=$((waited + 1))
    done
    if [ $waited -ge 15 ]; then
      printf "\r  Waiting for server      " >&2
      echo " (check logs: mysandbox logs $NAME)" >&2
    fi

    URL=$(start_tunnel "$PORT" "$SANDBOX" "$SANDBOX/tunnel_method" "$SANDBOX/tunnel_url" || true)

    if [ -n "$URL" ]; then
      METHOD=$(cat "$SANDBOX/tunnel_method")
      echo "  Public URL ($METHOD): $URL"
      echo "  SANDBOX_URL=$URL"
    else
      echo "  (no tunnel — install ngrok or cloudflared)"
    fi

    echo ""
    echo "Press Ctrl+C to stop the sandbox and clean up."

    trap "echo ''; echo 'Stopping sandbox...'; case \"\$MODE\" in docker) docker_cleanup \"\$NAME\" ;; *) cli_cleanup \"\$NAME\" ;; esac; echo 'Done.'; exit 0" INT TERM HUP

    sleep infinity 2>/dev/null || while true; do sleep 1; done
    ;;

  create)
    NAME="${2:-}"; [ -z "$NAME" ] && usage
    PORT=$(find_port $PORT_BASE)
    SANDBOX="$SANDBOX_DIR/$NAME"

    # Reap any existing sandbox with this name (stale from unclean shutdown)
    [ -d "$SANDBOX" ] && safe_rm "$SANDBOX"

    build_api

    if [ "$MODE" = "docker" ]; then
      echo "  Starting container (Docker mode)..." >&2
      docker_start_api "$NAME" "$PORT"
    else
      resolve_db_mode "$NAME"
      db_mode=$(cat "$SANDBOX/db_mode")
      if [ "$db_mode" = "docker" ]; then
        echo "  Starting container..." >&2
        docker_start_api "$NAME" "$PORT"
      else
        echo "  Starting Next.js server..." >&2
        cli_start_api "$NAME" "$PORT"
      fi
    fi

    printf "  Waiting for server" >&2
    waited=0
    frames=('.   ' '..  ' '... ')
    while [ $waited -lt 15 ]; do
      if command -v curl &>/dev/null && curl -s -o /dev/null "http://127.0.0.1:$PORT/api/calculate" 2>/dev/null; then
        printf "\r  Waiting for server      " >&2
        printf "\r  Almost ready...         \n" >&2
        break
      fi
      printf "\r  Waiting for server %s" "${frames[$((waited % 3))]}" >&2
      sleep 1
      waited=$((waited + 1))
    done
    if [ $waited -ge 15 ]; then
      printf "\r  Waiting for server      " >&2
      echo " (check logs: mysandbox logs $NAME)" >&2
    fi

    URL=$(start_tunnel "$PORT" "$SANDBOX" "$SANDBOX/tunnel_method" "$SANDBOX/tunnel_url" || true)
    METHOD=$(cat "$SANDBOX/tunnel_method" 2>/dev/null || echo "")
    print_info "$NAME" "$PORT" "$URL" "$METHOD"
    ;;

  stop)
    NAME="${2:-}"
    if [ -n "$NAME" ]; then
      echo "Stopping sandbox '$NAME'..."
      case "$MODE" in
        docker) docker_cleanup "$NAME" ;;
        *)     cli_cleanup "$NAME" ;;
      esac
      echo "Done."
    else
      echo "Stopping all sandboxes..."
      case "$MODE" in
        docker) docker_stop_all ;;
        *)     cli_stop_all ;;
      esac
      echo "All sandboxes stopped."
    fi
    ;;

  list)
    case "$MODE" in
      docker)
        docker ps --filter "label=com.docker.compose.project" \
          --format "table {{.Names}}\t{{.Ports}}\t{{.Status}}" 2>/dev/null
        podman ps --filter "label=com.docker.compose.project" \
          --format "table {{.Names}}\t{{.Ports}}\t{{.Status}}" 2>/dev/null
        ;;
      *)
        if ! [ -d "$SANDBOX_DIR" ]; then echo "No sandboxes."; exit 0; fi
        any=false
        for dir in "$SANDBOX_DIR"/*/; do
          [ -d "$dir" ] || continue
          name=$(basename "$dir")
          pid=$(cat "$dir/pid" 2>/dev/null || echo "?")
          port=$(cat "$dir/port" 2>/dev/null || echo "?")
          turl=$(cat "$dir/tunnel_url" 2>/dev/null || echo "")
          tmethod=$(cat "$dir/tunnel_method" 2>/dev/null || echo "")
          if [ -f "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null; then
            any=true
            echo "$name  running  :$port  pid $pid"
            [ -n "$turl" ] && echo "  public (${tmethod:-?}): $turl"
          else
            # Orphaned sandbox — clean it up silently
            safe_rm "$dir"
          fi
        done
        $any || echo "No sandboxes."
        ;;
    esac
    ;;

  kill)
    NAME="${2:-}"; [ -z "$NAME" ] && usage
    case "$MODE" in
      docker) docker_cleanup "$NAME" ;;
      *)     cli_cleanup "$NAME" ;;
    esac
    echo "Sandbox '$NAME' removed."
    ;;

  logs)
    NAME="${2:-}"; [ -z "$NAME" ] && usage
    case "$MODE" in
      docker)
        docker compose -p "$NAME" -f "$COMPOSE_FILE" logs -f
        ;;
      *)
        LOG="$SANDBOX_DIR/$NAME/output.log"
        if [ ! -f "$LOG" ]; then echo "No logs for '$NAME'."; exit 1; fi
        tail -f "$LOG"
        ;;
    esac
    ;;

  db)
    NAME="${2:-}"; [ -z "$NAME" ] && usage
    case "$MODE" in
      docker)
        docker compose -p "$NAME" -f "$COMPOSE_FILE" exec db psql -U "$PG_USER" -d "$PG_DB"
        ;;
      *)
        PGPASSWORD=$PG_PASS psql -h localhost -U "$PG_USER" -d "${PG_DB}_${NAME}"
        ;;
    esac
    ;;

  install)
    cmd_install
    ;;

  uninstall)
    cmd_uninstall
    ;;

  *) usage ;;
esac
